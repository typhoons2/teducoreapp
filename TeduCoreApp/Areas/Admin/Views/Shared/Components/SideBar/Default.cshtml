@model List<TeduCoreApp.Application.ViewModels.System.FunctionViewModel>
<!-- sidebar menu -->
<div id="sidebar-menu" class="main_menu_side hidden-print main_menu">
    <div class="menu_section">
        <h3>Functions</h3>
        <ul class="nav side-menu">
            @if (Model != null)
            {
                @foreach (var item in Model.Where(x => string.IsNullOrEmpty(x.ParentId)).OrderBy(x => x.SortOrder))
                {
                    var children = Model.Where(x => x.ParentId == item.Id).OrderBy(x => x.SortOrder).ToList();
                    <li>
                        <a>
                            <i class="@item.IconCss"></i> @item.Name
                            @if (children.Any())
                            {
                                <span class="fa fa-chevron-down"></span>
                            }
                        </a>
                        @if (children.Any())
                        {
                            <ul class="nav child_menu">
                                @foreach (var child in children)
                                {
                                    <li><a href="@child.URL">@child.Name</a></li>
                                }
                            </ul>
                        }
                    </li>
                }
            }
        </ul>
    </div>
</div>
<!-- /sidebar menu -->


